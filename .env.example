# Frontend API configuration
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
# Optional public Google Maps browser key; leave blank to use the no-key map state.
VITE_GOOGLE_MAPS_API_KEY=

# For a deployed frontend, replace the values with the public backend origin.
# Never put private backend keys in VITE_* variables.

# InsForge browser configuration for live persistence and hosting.
VITE_INSFORGE_BASE_URL=https://your-project.region.insforge.app
VITE_INSFORGE_ANON_KEY=your-public-anon-key
VITE_DEMO_MODE=false
